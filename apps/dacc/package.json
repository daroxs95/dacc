{
  "name": "dacc",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "start": "tsx --env-file-if-exists=.env server/node.ts",
    "test": "node --experimental-sqlite --import tsx --test app/lib/*.test.ts server/*.test.ts",
    "typecheck": "react-router typegen && tsc",
    "dev:server": "tsx watch --env-file-if-exists=.env server/node.ts",
    "setup:cloudflare": "npm --prefix tools/cloudflare ci",
    "cloudflare": "node ./tools/cloudflare/node_modules/wrangler/bin/wrangler.js",
    "dev:cloudflare": "npm run build && npm run cloudflare -- dev",
    "db:migrate:cloudflare": "npm run cloudflare -- d1 migrations apply dacc --remote",
    "deploy:cloudflare": "npm run build && npm run cloudflare -- deploy"
  },
  "dependencies": {
    "@react-router/node": "^7.1.5",
    "@react-router/serve": "^7.1.5",
    "isbot": "^5.1.17",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^7.1.5",
    "hono": "^4.10.0",
    "@hono/node-server": "^1.19.0",
    "@modelcontextprotocol/sdk": "^1.25.0",
    "arctic": "^3.7.0",
    "better-sqlite3": "^11.10.0"
  },
  "devDependencies": {
    "@react-router/dev": "^7.1.5",
    "@types/node": "^20",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.1",
    "fake-indexeddb": "^6.2.5",
    "react-router-devtools": "^1.1.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vite-tsconfig-paths": "^5.1.4",
    "@types/better-sqlite3": "^7.6.13",
    "@cloudflare/workers-types": "^4.20251117.0"
  }
}
