{
  "name": "dacc",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "start": "vite preview --host 0.0.0.0",
    "test": "tsx --test app/lib/*.test.ts",
    "typecheck": "react-router typegen && tsc",
    "setup:cloudflare": "npm --prefix tools/cloudflare ci",
    "cloudflare": "node ./tools/cloudflare/node_modules/wrangler/bin/wrangler.js",
    "deploy": "npm run build && npm run cloudflare -- deploy",
    "deploy:dry-run": "npm run build && npm run cloudflare -- deploy --dry-run",
    "preview:cloudflare": "npm run build && npm run cloudflare -- dev"
  },
  "dependencies": {
    "@react-router/node": "^7.1.5",
    "@react-router/serve": "^7.1.5",
    "isbot": "^5.1.17",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^7.1.5"
  },
  "devDependencies": {
    "@react-router/dev": "^7.1.5",
    "@types/node": "^20",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.1",
    "fake-indexeddb": "^6.2.5",
    "react-router-devtools": "^1.1.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vite-tsconfig-paths": "^5.1.4"
  }
}
